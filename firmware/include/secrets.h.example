/* Copy this file to secrets.h and set your own passphrase:
 *
 *     cp firmware/include/secrets.h.example firmware/include/secrets.h
 *
 * secrets.h is gitignored. This template is not.
 *
 * Why this is a real credential and not a formality: the aircraft runs a
 * SoftAP, and anything joined to that network can send UDP on the command
 * port. The firmware validates every packet (magic, version, CRC-16, strict
 * sequence, and a held ARM authority) — but validation proves a packet is
 * well-formed, not that it came from you. WPA2 is the only thing standing
 * between a stranger within radio range and a legitimate-looking command
 * stream. A passphrase published in a public repository is not a passphrase.
 *
 * WPA2 requires 8 to 63 characters. Use something you have not used elsewhere;
 * it is transmitted to nothing and stored only here.
 */
#ifndef PURSUIT_SECRETS_H
#define PURSUIT_SECRETS_H

#define PURSUIT_AP_SSID "PURSUIT-1"
#define PURSUIT_AP_PASS "change-me-before-you-fly"


/* ---- optional: bench station mode ------------------------------------
 *
 * Uncomment and fill in your own network to make the aircraft JOIN it at boot
 * instead of hosting its own AP. The point is bench convenience: joining the
 * aircraft's AP costs the laptop its internet connection, so every camera
 * stream, blackbox download and telemetry check means disconnecting from
 * everything else first.
 *
 * Safe to leave defined permanently. If the network is not reachable -- in a
 * field, or with the router off -- the join times out after
 * PURSUIT_STA_TIMEOUT_MS and the SoftAP comes up exactly as before.
 *
 * The aircraft's address CHANGES in station mode. It is printed at boot; do
 * not assume 192.168.4.1.
 */
/* #define PURSUIT_STA_SSID "your-home-network" */
/* #define PURSUIT_STA_PASS "your-network-password" */

#endif /* PURSUIT_SECRETS_H */
